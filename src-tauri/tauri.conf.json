{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worship Presenter",
  "version": "0.1.0",
  "identifier": "app.worshippresenter.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worship Presenter",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "url": "index.html#/control"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/profiles/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Worship Presenter",
    "copyright": "\u00a9 2026 Worship Presenter",
    "category": "Productivity",
    "shortDescription": "Church presentation software for songs, scripture and media",
    "longDescription": "Worship Presenter shows songs, Bible passages, announcements, PowerPoint and media on projectors, streams and stage displays, with Ghanaian-language support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Worship Presenter",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  }
}
